
# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local development.
#
# On Vercel, add these variables under:
# Project > Settings > Environment Variables
# ==========================================

# Supabase PostgreSQL Shared Pooler
DATABASE_URL=postgresql://postgres.vrowqvxbwiwtdxtwepdt:YOUR_DATABASE_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Your real Supabase database password (Project Settings > Database).
# The app puts it into DATABASE_URL in place of YOUR_DATABASE_PASSWORD,
# so special characters (@ # / ? %) need no URL-encoding.
DATABASE_PASSWORD=

# Session signing secret
SESSION_SECRET=replace_with_a_secure_random_secret

# Administrator account
ADMIN_EMAIL=admin@jaabm.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_NAME=Administrator

# Application port
PORT=3000
