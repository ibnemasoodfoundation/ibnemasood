# Copy to .env for local runs. On Vercel, add the same names under
# Project > Settings > Environment Variables.

# Supabase > Connect > "Transaction pooler" connection string (port 6543),
# with [YOUR-PASSWORD] replaced by your database password
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Long random string used to sign login cookies
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, created only when the database has no admin yet
ADMIN_EMAIL=admin@jaabm.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

PORT=3000
