# Copy to .env for local runs. On Vercel, add the same names under
# Project > Settings > Environment Variables, then redeploy.

# Supabase > Connect > "Transaction pooler" (port 6543). Works on Vercel (IPv4).
# Do NOT use the direct db.<ref>.supabase.co:5432 address on Vercel: it is IPv6-only.
DATABASE_URL=postgresql://postgres.vrowqvxbwiwtdxtwepdt:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Optional: the database password on its own. When set it replaces the password in
# DATABASE_URL, so special characters (@ # / ? %) need no URL-encoding.
DATABASE_PASSWORD=

# Long random string used to sign login cookies
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, created only when the database has no admin yet
ADMIN_EMAIL=admin@jaabm.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

PORT=3000
