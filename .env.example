# Copy to .env, or set these in your hosting dashboard
PORT=3000
# Long random string used to sign login cookies (required in production)
SESSION_SECRET=change-me-to-a-long-random-string
# First admin account, created only when the database has no admin yet
ADMIN_EMAIL=admin@jaabm.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Where the SQLite database file lives
DB_PATH=./data/jaabm.db
