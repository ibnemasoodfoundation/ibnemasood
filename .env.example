# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local development.
# .env is private: it is git-ignored and must never be committed.
# ==========================================

# Session signing secret (any long random text). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_secret

# Administrator account, created on first start when there is no admin yet
ADMIN_EMAIL=admin@jaabm.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_NAME=Administrator

# Application port
PORT=3000

# Database
# Leave DATABASE_URL empty for local development: the app uses a built-in
# Postgres (PGlite) saved in ./data/pgdata. Delete that folder to start fresh.
# Set DATABASE_URL only when moving to a hosted Postgres database.
DATABASE_URL=
# DB_DIR=./data/pgdata
