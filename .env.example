# Copy to .env for local runs. On Vercel, add the same names under
# Project > Settings > Environment Variables.

# Supabase project database (replace [YOUR-PASSWORD]; URL-encode special characters).
# On Vercel, use the project's Transaction pooler connection string from Supabase > Connect.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vrowqvxbwiwtdxtwepdt.supabase.co:5432/postgres?sslmode=require

# Long random string used to sign login cookies
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, created only when the database has no admin yet
ADMIN_EMAIL=admin@jaabm.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

PORT=3000
