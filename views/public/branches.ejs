<%- include('_head') %>
<main id="main">
<section class="page-hero">
  <div class="wrap">
    <div>
      <div class="crumbs"><a href="/">Home</a> / <a href="/makatib">Makatib</a> / Branches</div>
      <h1>Branches</h1>
      <p>The Makatib are organised into branches across Naushahro Feroze and Khairpur. Open a branch to see its Makatib.</p>
    </div>
    <div class="ar-big" lang="ur" aria-hidden="true">شاخیں</div>
  </div>
</section>
<section class="sec">
  <div class="wrap">
    <% if (!rows.length) { %>
      <div class="dir-empty"><p>Branch information is being added. Please see the <a href="/makatib">Makatib directory</a> or contact the Jamia office.</p></div>
    <% } else { %>
      <div class="dir-grid">
        <% rows.forEach(function (b) { %>
          <article class="dir-card">
            <a class="dir-photo" href="/branches/<%= b.code %>" tabindex="-1" aria-hidden="true"><% if (b.photo_id) { %><img src="/media/<%= b.photo_id %>" alt="" loading="lazy"><% } else { %><span class="dir-photo-empty" lang="ur">شاخ</span><% } %></a>
            <div class="dir-body">
              <h3><a href="/branches/<%= b.code %>"><%= b.name_en %></a></h3>
              <% if (b.name_ur) { %><p class="dir-ur" lang="ur" dir="rtl"><%= b.name_ur %></p><% } %>
              <p class="dir-place"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg><span><%= [b.town, b.tehsil, b.district].filter(Boolean).join(', ') %></span></p>
              <p class="dir-meta"><%= b.makatib %> <%= b.makatib === 1 ? 'Maktab' : 'Makatib' %> listed<% if (b.phone) { %> · <a href="tel:<%= b.phone %>"><%= b.phone %></a><% } %></p>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
</main>
<%- include('_footer') %>
