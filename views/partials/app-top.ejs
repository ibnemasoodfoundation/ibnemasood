<%- include('head') %>
<%
const r = user.role;
const officeRole = r === 'admin' || r === 'manager';          // admissions, messages
const unitRole = officeRole || r === 'nazim' || r === 'principal'; // teachers, students, attendance, results
const homeLabel = { admin: 'Overview', manager: 'Overview', nazim: 'Overview', principal: 'Overview', accountant: 'Overview' }[r] || 'My dashboard';
const nav = [{ href: '/app', label: homeLabel, icon: 'home' }];
if (typeof jamiaNav !== 'undefined' && jamiaNav.length) {
  nav.push({ section: 'Jamia' });
  jamiaNav.forEach((sec) => nav.push({ href: '/app/jamia/' + sec, label: sec === 'boys' ? 'Jamia Abdullah Bin Masood (Baneen)' : 'Jamia Aisha Siddiqa (Banaat)', icon: sec === 'boys' ? 'student' : 'student' }));
}
if (unitRole) {
  nav.push({ section: 'Institution' });
  if (officeRole) nav.push({ href: '/app/branches', label: 'Branches', icon: 'branch' });
  if (r !== 'principal') nav.push({ href: '/app/makatib', label: 'Makatib', icon: 'maktab' });
  if (r !== 'nazim') nav.push({ href: '/app/schools', label: 'Schools', icon: 'branch' });
  nav.push(
    { href: '/app/teachers', label: 'Teachers', icon: 'teacher' },
    { href: '/app/students', label: 'Students', icon: 'student' },
    { section: 'Attendance' },
    { href: '/app/attendance', label: 'Student attendance', icon: 'list', exact: true },
    { href: '/app/teacher-attendance', label: 'Teacher attendance', icon: 'teacher', exact: true },
    { href: '/app/attendance/report', label: 'Reports', icon: 'file', also: ['/app/reports', '/app/attendance/monthly', '/app/teacher-attendance/monthly'] },
    { href: '/app/results', label: 'Exams and results', icon: 'file' },
    r === 'principal'
      ? { section: 'Iqra Islamia Public School' }
      : { href: '/app/certificates', label: 'Certificates', icon: 'file', also: ['/app/forms'] },
    { section: 'Office' }
  );
}
if (r === 'principal') {
  // School documents sit in their own section, right after "Exams and results"
  const at = nav.findIndex((n) => n.section === 'Iqra Islamia Public School') + 1;
  nav.splice(at, 0,
    { href: '/app/school/register', label: 'Register student', icon: 'student' },
    { href: '/app/forms/admission', label: 'Admission form', icon: 'file' },
    { href: '/app/certificates', label: 'Leaving certificates', icon: 'file' });
}
if (r === 'teacher') nav.push(
  { href: '/app/students', label: 'My students', icon: 'student' },
  { href: '/app/attendance', label: 'Mark attendance', icon: 'list', exact: true },
  { href: '/app/attendance/monthly', label: 'Monthly sheet', icon: 'file' },
  { href: '/app/results', label: 'Exams and results', icon: 'file' }
);
if (r === 'admin' || r === 'accountant') {
  nav.push({ section: 'Accounts' },
    { href: '/app/finance/entries', label: 'Income and expenses', icon: 'list', also: ['/app/finance/new'] },
    { href: '/app/finance/report', label: 'Financial report', icon: 'file' });
  if (r === 'admin') nav.push({ href: '/app/finance', label: 'Accounts', icon: 'heart', exact: true });
}
if (r === 'user' || officeRole) nav.push({ href: '/app/admissions', label: officeRole ? 'Admissions' : 'My applications', icon: 'file' });
if (r === 'user' || officeRole || r === 'accountant') nav.push({ href: '/app/donations', label: r === 'user' ? 'My donations' : 'Donations', icon: 'heart' });
if (officeRole) nav.push({ href: '/app/messages', label: 'Messages', icon: 'mail' });
if (['admin', 'accountant', 'manager', 'principal'].includes(r)) nav.push({ href: '/app/fees', label: 'Student fees', icon: 'heart' });
if (['admin', 'accountant'].includes(r)) nav.push({ href: '/app/salaries', label: 'Teacher salaries', icon: 'teacher' });
nav.push({ href: '/app/announcements', label: 'Announcements', icon: 'bell' });
nav.push({ href: '/app/notifications', label: 'Notifications', icon: 'mail', also: ['/app/notifications/'] });
if (r === 'admin') {
  nav.push({ href: '/app/users', label: 'Users & roles', icon: 'users' });
  nav.push({ href: '/app/activity', label: 'Activity log', icon: 'list' });
  nav.push({ href: '/app/backup', label: 'Backup', icon: 'archive' });
}
nav.push({ href: '/app/profile', label: 'My profile', icon: 'user' });
const isOn = (href, n) => {
  if (href === '/app') return path === '/app' || path === '/app/';
  if (n && n.exact) return path === href;
  return path.startsWith(href) || (n && n.also || []).some((a) => path.startsWith(a));
};
%>
<body class="app-body">
<a class="skip" href="#app-main"><%= t('Skip to content') %></a>
<div class="app">
  <aside class="side" id="side">
    <a class="side-brand" href="/">
      <img src="/assets/images/logo-sm.jpg" alt="" width="44" height="44">
      <span><strong>Jamia Arabia</strong><small>Abdullah Bin Masood</small></span>
    </a>
    <div class="side-role role-<%= user.role %>"><%- include('icon', { name: 'shield' }) %><%= t(ROLE_LABELS[user.role]) %> <%= t('portal') %></div>
    <nav class="side-nav" aria-label="Dashboard">
      <% nav.forEach(function (n) { %>
        <% if (n.section) { %><span class="side-section"><%= t(n.section) %></span><% return; } %>
        <a href="<%= n.href %>" <% if (isOn(n.href, n)) { %>aria-current="page"<% } %>><%- include('icon', { name: n.icon }) %><span><%= t(n.label) %></span></a>
      <% }) %>
    </nav>
    <div class="side-foot">
      <a href="/"><%- include('icon', { name: 'globe' }) %><span><%= t('Public website') %></span></a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit"><%- include('icon', { name: 'out' }) %><span><%= t('Sign out') %></span></button>
      </form>
    </div>
  </aside>
  <div class="side-scrim" data-close-side></div>

  <div class="app-main">
    <header class="topnav">
      <button class="side-toggle" type="button" aria-controls="side" aria-expanded="false" aria-label="<%= t('Open menu') %>"><%- include('icon', { name: 'menu' }) %></button>
      <h1 class="topnav-title"><%= t(title) %></h1>
      <% if (['admin', 'manager', 'nazim', 'principal'].includes(user.role)) { const sec = typeof section !== 'undefined' ? section : ''; %>
        <nav class="lang-switch section-switch" aria-label="<%= t('Main branch') %>">
          <% [['all', 'All'], ['boys', 'Boys'], ['girls', 'Girls']].forEach(function (o) { %><a href="/section/<%= o[0] %>" <% if ((sec || 'all') === o[0]) { %>aria-current="true"<% } %> title="<%= o[0] === 'boys' ? 'Jamia Arabia Abdullah Bin Masood' : o[0] === 'girls' ? 'Jamia Arabia Aisha Siddiqa' : 'Both main branches' %>"><%= t(o[1]) %></a><% }) %>
        </nav>
      <% } %>
      <nav class="lang-switch" aria-label="<%= t('Language') %>">
        <%- include('icon', { name: 'globe' }) %>
        <% Object.keys(LANGS).forEach(function (code) { %><a href="/lang/<%= code %>" lang="<%= code %>" <% if (lang === code) { %>aria-current="true"<% } %>><%= LANGS[code].name %></a><% }) %>
      </nav>
      <a class="bell" href="/app/notifications" title="<%= t('Notifications') %>" aria-label="<%= t('Notifications') %><%= unread ? ': ' + unread + ' new' : '' %>">
        <%- include('icon', { name: 'bell' }) %><% if (unread) { %><span class="bell-count" data-bell-count><%= unread > 99 ? '99+' : unread %></span><% } else { %><span class="bell-count" data-bell-count hidden></span><% } %>
      </a>
      <a class="me" href="/app/profile" title="My profile">
        <span class="avatar"><%= initials(user.name) %></span>
        <span class="me-text"><strong><%= user.name %></strong><small><%= t(ROLE_LABELS[user.role]) %></small></span>
      </a>
    </header>
    <main id="app-main" class="content">
      <% if (flash) { %><div class="flash flash--<%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
      <% if (typeof freshNotes !== 'undefined' && freshNotes.length) { %>
        <section class="card fresh-notes" aria-label="<%= t('Notifications') %>">
          <div class="card-head"><h2><%- include('icon', { name: 'bell' }) %> <%= unread %> new notification<%= unread === 1 ? '' : 's' %></h2><a href="/app/notifications">View all</a></div>
          <ul class="notes-list notes-list--compact"><% freshNotes.forEach(function (n) { %>
            <li class="note note--unread note--<%= n.kind %>"><a href="/app/notifications/<%= n.id %>/open"><strong><%= n.title %></strong><% if (n.body) { %><span class="note-body"><%= n.body %></span><% } %><small><%= fmtDateTime(n.created_at) %></small></a></li>
          <% }) %></ul>
        </section>
      <% } %>
