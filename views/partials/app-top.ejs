<%- include('head') %>
<%
const staffRole = user.role === 'admin' || user.role === 'manager';
const teacherRole = user.role === 'teacher';
const nav = [
  { href: '/app', label: user.role === 'user' || teacherRole ? 'My dashboard' : 'Overview', icon: 'home' },
];
if (staffRole) nav.push(
  { section: 'Institution' },
  { href: '/app/branches', label: 'Branches', icon: 'branch' },
  { href: '/app/makatib', label: 'Makatib', icon: 'maktab' },
  { href: '/app/teachers', label: 'Teachers', icon: 'teacher' },
  { href: '/app/students', label: 'Students', icon: 'student' },
  { section: 'Attendance' },
  { href: '/app/attendance', label: 'Student attendance', icon: 'list', exact: true },
  { href: '/app/teacher-attendance', label: 'Teacher attendance', icon: 'teacher', exact: true },
  { href: '/app/attendance/report', label: 'Reports', icon: 'file', also: ['/app/reports', '/app/attendance/monthly', '/app/teacher-attendance/monthly'] },
  { section: 'Office' }
);
if (teacherRole) nav.push(
  { href: '/app/students', label: 'My students', icon: 'student' },
  { href: '/app/attendance', label: 'Mark attendance', icon: 'list', exact: true },
  { href: '/app/attendance/monthly', label: 'Monthly sheet', icon: 'file' }
);
if (!teacherRole) nav.push(
  { href: '/app/admissions', label: staffRole ? 'Admissions' : 'My applications', icon: 'file' },
  { href: '/app/donations', label: staffRole ? 'Donations' : 'My donations', icon: 'heart' }
);
if (staffRole) nav.push({ href: '/app/messages', label: 'Messages', icon: 'mail' });
nav.push({ href: '/app/announcements', label: 'Announcements', icon: 'bell' });
if (user.role === 'admin') {
  nav.push({ href: '/app/users', label: 'Users & roles', icon: 'users' });
  nav.push({ href: '/app/activity', label: 'Activity log', icon: 'list' });
}
nav.push({ href: '/app/profile', label: 'My profile', icon: 'user' });
const isOn = (href, n) => {
  if (href === '/app') return path === '/app' || path === '/app/';
  if (n && n.exact) return path === href;
  return path.startsWith(href) || (n && n.also || []).some((a) => path.startsWith(a));
};
%>
<body class="app-body">
<a class="skip" href="#app-main">Skip to content</a>
<div class="app">
  <aside class="side" id="side">
    <a class="side-brand" href="/">
      <img src="/assets/images/logo-sm.jpg" alt="" width="44" height="44">
      <span><strong>Jamia Arabia</strong><small>Abdullah Bin Masood</small></span>
    </a>
    <div class="side-role role-<%= user.role %>"><%- include('icon', { name: 'shield' }) %><%= ROLE_LABELS[user.role] %> portal</div>
    <nav class="side-nav" aria-label="Dashboard">
      <% nav.forEach(function (n) { %>
        <% if (n.section) { %><span class="side-section"><%= n.section %></span><% return; } %>
        <a href="<%= n.href %>" <% if (isOn(n.href, n)) { %>aria-current="page"<% } %>><%- include('icon', { name: n.icon }) %><span><%= n.label %></span></a>
      <% }) %>
    </nav>
    <div class="side-foot">
      <a href="/"><%- include('icon', { name: 'globe' }) %><span>Public website</span></a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit"><%- include('icon', { name: 'out' }) %><span>Sign out</span></button>
      </form>
    </div>
  </aside>
  <div class="side-scrim" data-close-side></div>

  <div class="app-main">
    <header class="topnav">
      <button class="side-toggle" type="button" aria-controls="side" aria-expanded="false" aria-label="Open menu"><%- include('icon', { name: 'menu' }) %></button>
      <h1 class="topnav-title"><%= title %></h1>
      <a class="me" href="/app/profile" title="My profile">
        <span class="avatar"><%= initials(user.name) %></span>
        <span class="me-text"><strong><%= user.name %></strong><small><%= ROLE_LABELS[user.role] %></small></span>
      </a>
    </header>
    <main id="app-main" class="content">
      <% if (flash) { %><div class="flash flash--<%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
