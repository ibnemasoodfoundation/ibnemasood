<%- include('../partials/head') %>
<body class="auth-body">
<div class="auth">
  <%- include('_panel') %>
  <main class="auth-form">
    <div class="auth-card">
      <a class="auth-mobile-brand" href="/"><img src="/assets/images/logo-sm.jpg" alt="" width="48" height="48"><span>Jamia Arabia<br>Abdullah Bin Masood</span></a>
      <h1>Create an account</h1>
      <p class="auth-sub">For parents, students and supporters of the Jamia.</p>
      <form method="post" action="/signup" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field <%= errors.name ? 'invalid' : '' %>"><label for="name">Full name</label><input id="name" name="name" autocomplete="name" value="<%= values.name || '' %>" required autofocus><span class="err"><%= errors.name %></span></div>
        <div class="field <%= errors.email ? 'invalid' : '' %>"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" value="<%= values.email || '' %>" required><span class="err"><%= errors.email %></span></div>
        <div class="field <%= errors.phone ? 'invalid' : '' %>"><label for="phone">Phone number <span class="opt">optional</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="03XX XXXXXXX" value="<%= values.phone || '' %>"><span class="err"><%= errors.phone %></span></div>
        <div class="field-row">
          <div class="field <%= errors.password ? 'invalid' : '' %>">
            <label for="password">Password</label>
            <div class="pw"><input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required><button type="button" class="pw-toggle" data-pw="password">Show</button></div>
            <span class="err"><%= errors.password %></span>
          </div>
          <div class="field <%= errors.confirm ? 'invalid' : '' %>"><label for="confirm">Confirm password</label><input id="confirm" name="confirm" type="password" autocomplete="new-password" required><span class="err"><%= errors.confirm %></span></div>
        </div>
        <p class="hint">At least 8 characters.</p>
        <button class="btn btn--gold btn--block" type="submit">Create account</button>
      </form>
      <p class="auth-alt">Already have an account? <a href="/login">Sign in</a></p>
    </div>
  </main>
</div>
<script src="/assets/js/app.js"></script>
</body>
</html>
