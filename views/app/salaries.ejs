<%- include('../partials/app-top') %>
<% const qs = (o) => new URLSearchParams(Object.assign({ month: f.month, group: f.group, status: f.status }, o)).toString(); %>
<div class="page-head">
  <p>Salaries for <strong><%= monthName %></strong>: Jamia, school and Makatib teachers. Each payment is added to the accounts as an expense, and the teacher is notified. The amount comes from the monthly salary on the teacher’s profile and can be changed before paying.</p>
</div>
<form class="filters" method="get">
  <label class="filter-label">Month <input type="month" name="month" value="<%= f.month %>"></label>
  <select name="group" aria-label="Where they teach"><option value="">All teachers</option><% Object.keys(GROUPS).forEach(function (g) { %><option value="<%= g %>" <%= f.group === g ? 'selected' : '' %>><%= GROUPS[g] %></option><% }) %></select>
  <select name="status" aria-label="Status"><option value="">Paid and unpaid</option><option value="unpaid" <%= f.status === 'unpaid' ? 'selected' : '' %>>Not paid yet</option><option value="paid" <%= f.status === 'paid' ? 'selected' : '' %>>Paid</option></select>
  <button class="btn btn--line btn--sm" type="submit">Show</button>
</form>

<div class="stats">
  <a class="stat stat--gold" href="?<%= qs({ status: 'paid' }) %>"><small>Paid this month</small><strong><%= money(totals.paidAmount) %></strong><span><%= totals.paid %> of <%= totals.teachers %> teachers</span></a>
  <a class="stat <%= totals.teachers - totals.paid ? 'stat--warn' : '' %>" href="?<%= qs({ status: 'unpaid' }) %>"><small>Still to pay</small><strong><%= money(totals.pendingAmount) %></strong><span><%= totals.teachers - totals.paid %> teachers</span></a>
  <% byGroup.forEach(function (g) { %><a class="stat" href="?<%= qs({ group: g.g }) %>"><small><%= g.label %></small><strong><%= g.paid %> / <%= g.n %></strong><span><%= money(g.amount) %> paid</span></a><% }) %>
</div>

<% if (totals.teachers - totals.paid) { %>
  <form class="btn-row fee-actions" method="post" action="/app/salaries/pay-all" data-confirm="Pay every unpaid teacher shown their monthly salary for <%= monthName %>?">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="month" value="<%= f.month %>"><input type="hidden" name="group" value="<%= f.group %>">
    <select name="method" aria-label="Method"><% PAYMENT_METHODS.forEach(function (m) { %><option><%= m %></option><% }) %></select>
    <button class="btn btn--gold btn--sm" type="submit"><%- include('../partials/icon', { name: 'heart' }) %>Pay all unpaid<%= f.group ? ' (' + GROUPS[f.group] + ')' : '' %></button>
    <% if (totals.noSalary) { %><span class="muted small-inline"><%= totals.noSalary %> teacher<%= totals.noSalary === 1 ? ' has' : 's have' %> no monthly salary on their profile and will be skipped.</span><% } %>
  </form>
<% } %>

<section class="card card--flush">
  <% if (!rows.length) { %><p class="empty">No teachers for this selection.</p><% } else { %>
    <div class="table-wrap"><table class="table fee-table">
      <thead><tr><th>Teacher</th><th>Teaches at</th><th class="t-right">Monthly salary</th><th>Status</th><th>Pay</th><th></th></tr></thead>
      <tbody><% rows.forEach(function (r) { %>
        <tr>
          <td><a class="row-link" href="/app/teachers/<%= r.id %>"><strong><%= r.full_name %></strong></a><small><%= r.code %><%= r.designation ? ' · ' + r.designation : '' %><%= r.user_id ? '' : ' · no login' %></small></td>
          <td><%= r.place || '—' %><small><%= GROUPS[r.grp] %></small></td>
          <td class="t-right num"><%= r.salary ? money(r.salary) : '—' %></td>
          <td><% if (r.pay_id) { %><span class="badge badge--present">Paid <%= money(r.net) %></span><small><%= fmtDate(r.paid_on) %></small><% } else { %><span class="badge badge--absent">Not paid</span><% } %></td>
          <td>
            <% if (!r.pay_id) { %>
              <form class="fee-pay" method="post" action="/app/salaries/pay">
                <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="teacher_id" value="<%= r.id %>"><input type="hidden" name="month" value="<%= f.month %>">
                <input type="hidden" name="group" value="<%= f.group %>"><input type="hidden" name="status" value="<%= f.status %>">
                <input name="basic" inputmode="numeric" value="<%= r.salary || '' %>" placeholder="Salary" aria-label="Salary for <%= r.full_name %>" size="6">
                <input name="allowance" inputmode="numeric" placeholder="+ Allow." aria-label="Allowance" size="5">
                <input name="deduction" inputmode="numeric" placeholder="− Deduct." aria-label="Deduction" size="5">
                <select name="method" aria-label="Method"><% PAYMENT_METHODS.forEach(function (m) { %><option><%= m %></option><% }) %></select>
                <button class="btn-sm btn-sm--ok" type="submit">Pay</button>
              </form>
            <% } %>
          </td>
          <td class="t-right nowrap">
            <% if (r.pay_id) { %><a class="btn-sm" href="/app/salaries/<%= r.pay_id %>/slip" target="_blank">Slip</a><% } %>
            <% if (r.pay_id && user.role === 'admin') { %><form class="inline" method="post" action="/app/salaries/<%= r.pay_id %>/delete" data-confirm="Remove the salary payment of <%= r.full_name %> for <%= monthName %>, and its expense entry?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn-sm btn-sm--danger" type="submit">Undo</button></form><% } %>
          </td>
        </tr>
      <% }) %></tbody>
    </table></div>
  <% } %>
</section>
<%- include('../partials/app-bottom') %>
