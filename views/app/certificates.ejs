<%- include('../partials/app-top') %>
<div class="page-head">
  <% if (only === 'leaving') { %>
    <p>School Leaving Certificates of Iqra Islamia Public School. To issue one, open a school student’s profile and choose <strong>Leaving certificate</strong>.</p>
  <% } else if (only === 'alimiyyah') { %>
    <p>Shahadat al-Alamiyyah certificates of the Jamia. To issue one, open a student’s profile and choose <strong>Alimiyyah certificate</strong>; the marks and grade can come from an exam result.</p>
  <% } else { %>
    <p>School Leaving Certificates (Iqra Islamia Public School students) and Shahadat al-Alamiyyah certificates (Jamia students). To issue one, open the student’s profile.</p>
  <% } %>
  <% if (only !== 'alimiyyah') { %><a class="btn btn--line btn--sm" href="/app/forms/admission" target="_blank"><%- include('../partials/icon', { name: 'file' }) %>Blank admission form</a><% } %>
</div>
<section class="card card--flush">
  <% if (!rows.length) { %><p class="empty">No certificates issued yet.</p><% } else { %>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>Certificate</th><th>Student</th><th>No.</th><th>Issued</th><th></th></tr></thead>
      <tbody><% rows.forEach(function (c) { %>
        <tr>
          <td><strong><%= KINDS[c.kind] %></strong></td>
          <td><% if (c.student_id) { %><a href="/app/students/<%= c.student_id %>"><%= c.full_name %></a><small><%= c.code %></small><% } else { %><%= (c.data || {}).name || '—' %><% } %></td>
          <td><%= c.serial_no || '—' %></td>
          <td><%= fmtDate(c.issued_on) %></td>
          <td class="t-right nowrap"><a class="btn-sm" href="/app/certificates/<%= c.id %>" target="_blank">Print</a> <a class="btn-sm" href="/app/certificates/<%= c.id %>/edit">Edit</a></td>
        </tr>
      <% }) %></tbody>
    </table></div>
  <% } %>
</section>
<%- include('../partials/app-bottom') %>
