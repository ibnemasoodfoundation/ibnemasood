<div class="stats">
  <a class="stat" href="/app/admissions?status=pending"><small>Applications waiting</small><strong><%= stats.pendingAdmissions %></strong><span>Need review</span></a>
  <a class="stat" href="/app/admissions?status=approved"><small>Enrolled students</small><strong><%= stats.students %></strong><span>Approved admissions</span></a>
  <a class="stat" href="/app/donations?status=pending"><small>Donations to verify</small><strong><%= stats.pendingDonations %></strong><span>Pending confirmation</span></a>
  <a class="stat stat--gold" href="/app/donations?status=verified"><small>Verified this month</small><strong><%= money(stats.monthTotal) %></strong><span>Donations received</span></a>
  <a class="stat" href="/app/messages?status=new"><small>New messages</small><strong><%= stats.newMessages %></strong><span>From the contact form</span></a>
</div>

<div class="grid-2">
  <section class="card">
    <div class="card-head"><h2>Applications waiting for review</h2><a href="/app/admissions?status=pending">View all</a></div>
    <% if (!recentAdmissions.length) { %>
      <p class="empty">No pending applications. Alhamdulillah, all caught up.</p>
    <% } else { %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>Student</th><th>Branch</th><th>Programme</th><th>Received</th><th></th></tr></thead>
        <tbody>
        <% recentAdmissions.forEach(function (a) { %>
          <tr>
            <td><strong><%= a.student_name %></strong><small>s/o, d/o <%= a.father_name %></small></td>
            <td><%= cap(a.branch) %></td>
            <td><%= a.programme %></td>
            <td><%= fmtDate(a.created_at) %></td>
            <td class="t-right"><a class="btn-sm" href="/app/admissions/<%= a.id %>">Review</a></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </section>

  <section class="card">
    <div class="card-head"><h2>Enrolled students by branch</h2></div>
    <% const maxB = Math.max(1, ...byBranch.map(b => b.n)); %>
    <ul class="bars">
      <% byBranch.forEach(function (b) { %>
        <li>
          <span class="bars-label"><%= BRANCHES[b.key] %></span>
          <span class="bars-track"><span class="bars-fill" style="width:<%= Math.round(b.n / maxB * 100) %>%"></span></span>
          <span class="bars-val"><%= b.n %></span>
        </li>
      <% }) %>
    </ul>
    <div class="quick">
      <a class="btn btn--blue btn--sm" href="/app/donations/new"><%- include('../partials/icon', { name: 'plus' }) %>Record donation</a>
      <a class="btn btn--line btn--sm" href="/app/announcements"><%- include('../partials/icon', { name: 'bell' }) %>Post announcement</a>
    </div>
  </section>
</div>

<section class="card">
  <div class="card-head"><h2>Latest donations</h2><a href="/app/donations">View all</a></div>
  <% if (!recentDonations.length) { %>
    <p class="empty">No donations recorded yet.</p>
  <% } else { %>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>Donor</th><th>Type</th><th>Method</th><th class="t-right">Amount</th><th>Date</th><th>Status</th></tr></thead>
      <tbody>
      <% recentDonations.forEach(function (d) { %>
        <tr>
          <td><strong><%= d.donor_name %></strong></td>
          <td><%= d.kind %></td>
          <td><%= d.method %></td>
          <td class="t-right num"><%= money(d.amount) %></td>
          <td><%= fmtDate(d.created_at) %></td>
          <td><%- include('../partials/badge', { s: d.status }) %></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</section>
