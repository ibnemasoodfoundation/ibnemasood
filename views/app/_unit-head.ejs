<%# Header for a branch or Maktab page. Expects: u (record), route ('branches'|'makatib'), unitLabel, files %>
<% const cover = files.find(x => x.kind === 'photo'); %>
<section class="unit-head">
  <div class="unit-cover <%= cover ? '' : 'unit-cover--empty' %>">
    <% if (cover) { %><img src="/app/files/<%= cover.id %>" alt="<%= u.name_en %>"><% } else { %><%- include('../partials/icon', { name: route === 'branches' ? 'branch' : 'maktab' }) %><% } %>
  </div>
  <div class="unit-title">
    <div class="unit-meta"><span class="code-chip"><%= u.code %></span><%- include('../partials/badge', { s: u.status }) %></div>
    <h2><%= u.name_en %></h2>
    <% if (u.name_ur) { %><p class="unit-ur" lang="ur" dir="rtl"><%= u.name_ur %></p><% } %>
    <p class="unit-place"><%- include('../partials/icon', { name: 'pin' }) %><span><%= [u.town, u.tehsil, u.district].filter(Boolean).join(', ') %><%= u.address ? ' · ' + u.address : '' %></span></p>
  </div>
  <div class="unit-actions">
    <% if (typeof canEdit === 'undefined' || canEdit) { %><a class="btn btn--line btn--sm" href="/app/<%= route %>/<%= u.id %>/edit"><%- include('../partials/icon', { name: 'edit' }) %>Edit</a><% } %>
    <% if (user.role === 'admin') { %>
      <form method="post" action="/app/<%= route %>/<%= u.id %>/archive" <% if (u.status !== 'archived') { %>data-confirm="Archive <%= u.name_en %>? It will be hidden from lists but nothing is deleted."<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (u.status === 'archived') { %><input type="hidden" name="restore" value="1"><button class="btn btn--line btn--sm" type="submit">Restore</button>
        <% } else { %><button class="btn btn--line btn--sm btn--danger-line" type="submit"><%- include('../partials/icon', { name: 'archive' }) %>Archive</button><% } %>
      </form>
    <% } %>
  </div>
</section>
