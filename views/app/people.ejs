<%- include('../partials/app-top') %>
<% const base = '/app/' + cfg.plural; %>
<div class="page-head">
  <p><%= type === 'teacher' ? 'Teachers across all Makatib. The full appointment form comes in the next phase.' : 'Enrolled students across all Makatib.' %></p>
  <a class="btn btn--blue btn--sm" href="<%= base %>/new"><%- include('../partials/icon', { name: 'plus' }) %>Register <%= cfg.label.toLowerCase() %></a>
</div>

<form class="filters" method="get">
  <input type="search" name="q" placeholder="Search name, code, father or phone" value="<%= filters.q %>" aria-label="Search">
  <select name="branch" aria-label="Branch">
    <option value="">All branches</option>
    <% branches.forEach(function (b) { %><option value="<%= b.id %>" <%= filters.branch === b.id ? 'selected' : '' %>><%= b.name_en %></option><% }) %>
  </select>
  <select name="maktab" aria-label="Maktab">
    <option value="">All Makatib</option>
    <% makatib.forEach(function (m) { %><option value="<%= m.id %>" <%= filters.maktab === m.id ? 'selected' : '' %>><%= m.name_en %></option><% }) %>
  </select>
  <select name="gender" aria-label="Gender">
    <option value="">Any gender</option>
    <% Object.keys(GENDERS).forEach(function (g) { %><option value="<%= g %>" <%= filters.gender === g ? 'selected' : '' %>><%= GENDERS[g] %></option><% }) %>
  </select>
  <select name="status" aria-label="Status">
    <option value="">Any status</option>
    <% cfg.statuses.forEach(function (s) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= cap(s) %></option><% }) %>
  </select>
  <button class="btn btn--line btn--sm" type="submit">Filter</button>
</form>

<p class="result-count"><%= rows.length %> <%= rows.length === 1 ? cfg.label.toLowerCase() : cfg.plural %></p>
<section class="card card--flush">
  <% if (!rows.length) { %>
    <p class="empty">No <%= cfg.plural %> found. <a href="<%= base %>/new">Register one</a>.</p>
  <% } else { %>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>Name</th><th>Gender</th><th>Maktab / branch</th><th>Phone</th><th>Status</th><th></th></tr></thead>
      <tbody><% rows.forEach(function (x) { %>
        <tr class="<%= x.status !== 'active' ? 'row-muted' : '' %>">
          <td><strong><%= x.full_name %></strong><small><%= x.code %><% if (x.name_ur) { %> · <span class="ur-inline" lang="ur"><%= x.name_ur %></span><% } %></small></td>
          <td><%= GENDERS[x.gender] %></td>
          <td><% if (x.maktab) { %><a href="/app/makatib/<%= x.maktab_id %>"><%= x.maktab %></a><% } else { %>No Maktab<% } %><small><%= x.branch || 'No branch' %></small></td>
          <td><%= x.phone || '—' %></td>
          <td><%- include('../partials/badge', { s: x.status }) %></td>
          <td class="t-right"><a class="btn-sm" href="<%= base %>/<%= x.id %>/edit">Edit</a></td>
        </tr>
      <% }) %></tbody>
    </table></div>
  <% } %>
</section>
<%- include('../partials/app-bottom') %>
